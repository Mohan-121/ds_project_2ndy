# ==============================================================================
# UrbanIQ: Environment Variables Configuration
# Coimbatore Digital Twin Platform
# ==============================================================================

# Core Application Settings
APP_NAME=UrbanIQ
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=urbaniq-development-insecure-secret-key-32chars-min!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Host and Port
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database URL
# In Docker: postgresql+psycopg2://urbaniq:urbaniq_secure_pass@postgres:5432/urbaniq_db
# Standalone local dev: sqlite:///./urbaniq.db
DATABASE_URL=sqlite:///./urbaniq.db

# Message Broker (MQTT Mosquitto)
# In Docker: mosquitto; Standalone: localhost (falls back to internal async bus if unreachable)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60

# External API Keys (Leave blank for Demo mode fallback with honest "NOT CONFIGURED" status)
GEMINI_API_KEY=
MAPBOX_ACCESS_TOKEN=
CESIUM_ION_ACCESS_TOKEN=
TOMTOM_API_KEY=
HERE_API_KEY=
OPENAQ_API_KEY=

# City Geographic Coordinates (Coimbatore Centre)
CITY_NAME=Coimbatore
CITY_STATE="Tamil Nadu"
CITY_COUNTRY=India
CITY_LAT=11.0168
CITY_LON=76.9558
CITY_TIMEZONE=Asia/Kolkata
DEFAULT_SRID=4326

# Quality & Ingestion Thresholds
STALE_CADENCE_MULTIPLIER=3
IQR_OUTLIER_THRESHOLD=1.5
MAX_REJECTED_LOGS_RETENTION_DAYS=30
